#!/usr/bin/env bash
# Fail-closed SANA HR rollout. Does not run Drizzle migrations automatically:
# the existing production database uses a different migration history.
set -Eeuo pipefail
umask 077
[[ $EUID -eq 0 && $# -eq 1 && "$1" =~ ^[0-9a-f]{40}$ ]] || { echo "Usage as root: sana-hr-deploy <40-hex-sha>" >&2; exit 2; }
sha="$1"
exec 9>/run/lock/sanaa-hr-production.lock
flock -x 9
root=/opt/sanaa-hr
incoming="/home/sana-deploy/incoming/hr-${sha}.tar.gz"
release="$root/releases/$sha"
app="$root/app"
[[ -s "$incoming" && -s /etc/sanaa-hr/hr.env ]] || { echo "Artifact or env missing" >&2; exit 1; }
[[ -d "$app" ]] || { echo "Existing HR app missing" >&2; exit 1; }
systemctl is-active --quiet sanaa-hr.service || { echo "Existing HR service inactive" >&2; exit 1; }
command -v docker >/dev/null || { echo "Docker needed for DB preflight" >&2; exit 1; }

# SQL introspection only. No DDL here. Stop rather than launch code against old schema.
missing="$(docker exec sanaa-hr-postgres psql -X -U sanaa_hr -d sanaa_hr -Atc "
SELECT string_agg(x.name, ',')
FROM (
  SELECT 'attendance_ingest_sources' AS name WHERE to_regclass('public.attendance_ingest_sources') IS NULL
  UNION ALL SELECT 'subscription_plans' WHERE to_regclass('public.subscription_plans') IS NULL
  UNION ALL SELECT 'integrations' WHERE to_regclass('public.integrations') IS NULL
  UNION ALL SELECT 'integration_requests' WHERE to_regclass('public.integration_requests') IS NULL
  UNION ALL SELECT 'attendance_devices.source_id' WHERE NOT EXISTS (
    SELECT 1 FROM information_schema.columns WHERE table_schema='public' AND table_name='attendance_devices' AND column_name='source_id')
) x;")" || { echo "Cannot verify HR database schema" >&2; exit 1; }
if [[ -n "$missing" ]]; then
  echo "HR schema prerequisites missing: $missing" >&2
  echo "Apply the separately reviewed additive HR migration plan before deploying." >&2
  exit 1
fi

stage=""
old=""
switched=0
moved=0
cleanup() {
  rc=$?
  trap - EXIT
  if ((rc!=0)); then
    echo "HR release failed, restoring previous application directory" >&2
    if ((switched)) && [[ -n "$old" ]]; then
      ln -sfn "$old" "$root/.app-rollback-$$"
      mv -Tf "$root/.app-rollback-$$" "$app"
      systemctl restart sanaa-hr.service || true
    elif ((moved)) && [[ -n "$old" && ! -e "$app" ]]; then
      mv "$old" "$app" || true
    fi
  fi
  [[ -z "$stage" || ! -d "$stage" ]] || rm -rf "$stage"
  exit "$rc"
}
trap cleanup EXIT
if [[ ! -d "$release" ]]; then
  stage="$(mktemp -d "$root/releases/.stage-${sha}-XXXXXXXX")"
  python3 - "$incoming" "$stage" <<'PY'
import sys,tarfile
with tarfile.open(sys.argv[1], 'r:gz') as arc:
    arc.extractall(sys.argv[2], filter='data')
PY
  [[ -s "$stage/package.json" && -d "$stage/dist" && -d "$stage/node_modules" ]] || { echo "Incomplete HR release" >&2; exit 1; }
  chmod -R a+rX "$stage"
  mv "$stage" "$release"
  stage=""
fi
# Require the exact schema contract packaged with the candidate immutable
# HR release. CI may build code successfully while live SQL is incompatible.
[[ -s "$release/ops/hr-schema-contract.json" &&
   -s "$release/ops/hr-schema-audit.sh" ]] || {
  echo "HR release has no version-controlled full schema audit" >&2; exit 1;
}
bash "$release/ops/hr-schema-audit.sh" "$release/ops/hr-schema-contract.json"
echo "Full HR database compatibility: OK"
if [[ ! -L "$app" ]]; then
  old="$root/app.previous-github-actions-$(date -u +%Y%m%dT%H%M%SZ)"
  mv "$app" "$old"
  moved=1
  ln -s "$old" "$app"
fi
old="$(readlink -f "$app")"
ln -s "$release" "$root/.app-next-$$"
mv -Tf "$root/.app-next-$$" "$app"
switched=1
systemctl restart sanaa-hr.service
healthy=0
for i in {1..25}; do
  status="$(curl -sS --max-time 5 -o /dev/null -w '%{http_code}' http://127.0.0.1:4050/ || true)"
  if [[ "$status" == "200" ]]; then healthy=1; break; fi
  sleep 3
done
((healthy)) || { echo "HR health check failed: $status" >&2; exit 1; }
echo "HR production deployed: $sha"
echo "No schema migration applied in this deploy."
rm -f "$incoming"
trap - EXIT
